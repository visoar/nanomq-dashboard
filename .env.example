# Server-side only. Never use NEXT_PUBLIC_ for broker credentials.
NANOMQ_API_URL=http://127.0.0.1:8081
# Comma-separated broker base URLs permitted on the connection screen.
# NANOMQ_ALLOWED_URLS=http://127.0.0.1:8081,https://broker.internal:8081
# Required in production: at least 32 characters, shared by all replicas.
# Generate with: openssl rand -hex 32
NANOMQ_SESSION_SECRET=
# Set true when the dashboard is served over HTTPS; false for local HTTP.
NANOMQ_SECURE_COOKIE=false
