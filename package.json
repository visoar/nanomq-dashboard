{
  "name": "nanomq-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "A focused operations console for NanoMQ HTTP API v4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "CAPTURE_SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "format": "biome format --write ."
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mqtt": "^5.16.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "@biomejs/biome": "2.5.15"
  },
  "type": "module"
}
